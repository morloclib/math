module math.test (test)

import math
import root
import unittest

test = suite runTests

-------------------------------------------------------------------------------
-- Test suite

runTests :: Test
runTests =
  ( group "Sign" testSign
  . group "Rounding" testRounding
  . group "Roots" testRoots
  . group "Exp/Log" testExpLog
  . group "Hyperbolic" testHyperbolic
  . group "Trig" testTrig
  . group "Constants" testConstants
  )

-------------------------------------------------------------------------------
-- Constants

testConstants :: Test
testConstants =
  ( testNear "pi" 1e-9 (pi :: Real) 3.141592653589793
  . testNear "e" 1e-9 (e :: Real) 2.718281828459045
  )

-------------------------------------------------------------------------------
-- Trigonometric

testTrig :: Test
testTrig =
  ( testNear "sin 0" 1e-9 (sin 0.0) 0.0
  . testNear "sin pi/2" 1e-9 (sin (pi / 2.0)) 1.0
  . testNear "sin pi" 1e-9 (sin (pi :: Real)) 0.0
  . testNear "cos 0" 1e-9 (cos 0.0) 1.0
  . testNear "cos pi/2" 1e-9 (cos (pi / 2.0)) 0.0
  . testNear "cos pi" 1e-9 (cos (pi :: Real)) (0.0 - 1.0)
  . testNear "tan 0" 1e-9 (tan 0.0) 0.0
  . testNear "tan pi/4" 1e-9 (tan (pi / 4.0)) 1.0
  . testNear "asin 0" 1e-9 (asin 0.0) 0.0
  . testNear "asin 1" 1e-9 (asin 1.0) (pi / 2.0)
  . testNear "acos 1" 1e-9 (acos 1.0) 0.0
  . testNear "acos 0" 1e-9 (acos 0.0) (pi / 2.0)
  . testNear "atan 0" 1e-9 (atan 0.0) 0.0
  . testNear "atan 1" 1e-9 (atan 1.0) (pi / 4.0)
  . testNear "atan2 1 1" 1e-9 (atan2 1.0 1.0) (pi / 4.0)
  . testNear "atan2 1 0" 1e-9 (atan2 1.0 0.0) (pi / 2.0)
  . testNear "atan2 0 1" 1e-9 (atan2 0.0 1.0) 0.0
  . testNear "atan2 -1 0" 1e-9 (atan2 (0.0 - 1.0) 0.0) (0.0 - pi / 2.0)
  -- sin^2 + cos^2 = 1
  . testNear "pythag 0.5" 1e-9 (sin 0.5 ** 2.0 + cos 0.5 ** 2.0) 1.0
  . testNear "pythag 1.0" 1e-9 (sin 1.0 ** 2.0 + cos 1.0 ** 2.0) 1.0
  )

-------------------------------------------------------------------------------
-- Hyperbolic

testHyperbolic :: Test
testHyperbolic =
  ( testNear "sinh 0" 1e-9 (sinh 0.0) 0.0
  . testNear "cosh 0" 1e-9 (cosh 0.0) 1.0
  . testNear "tanh 0" 1e-9 (tanh 0.0) 0.0
  . testNear "sinh 1" 1e-9 (sinh 1.0) 1.1752011936438014
  . testNear "cosh 1" 1e-9 (cosh 1.0) 1.5430806348152437
  . testNear "tanh 1" 1e-9 (tanh 1.0) 0.7615941559557649
  . testNear "asinh 0" 1e-9 (asinh 0.0) 0.0
  . testNear "acosh 1" 1e-9 (acosh 1.0) 0.0
  . testNear "atanh 0" 1e-9 (atanh 0.0) 0.0
  -- asinh(sinh(x)) = x
  . testNear "asinh-sinh" 1e-9 (asinh (sinh 1.5)) 1.5
  -- acosh(cosh(x)) = x for x >= 0
  . testNear "acosh-cosh" 1e-9 (acosh (cosh 2.0)) 2.0
  -- atanh(tanh(x)) = x
  . testNear "atanh-tanh" 1e-9 (atanh (tanh 0.5)) 0.5
  )

-------------------------------------------------------------------------------
-- Exponential and logarithmic

testExpLog :: Test
testExpLog =
  ( testNear "exp 0" 1e-9 (exp 0.0) 1.0
  . testNear "exp 1" 1e-9 (exp 1.0) (e :: Real)
  . testNear "exp 2" 1e-9 (exp 2.0) 7.38905609893065
  . testNear "log2 1" 1e-9 (log2 1.0) 0.0
  . testNear "log2 2" 1e-9 (log2 2.0) 1.0
  . testNear "log2 8" 1e-9 (log2 8.0) 3.0
  . testNear "log10 1" 1e-9 (log10 1.0) 0.0
  . testNear "log10 10" 1e-9 (log10 10.0) 1.0
  . testNear "log10 100" 1e-9 (log10 100.0) 2.0
  -- exp(ln(x)) = x
  . testNear "exp-ln" 1e-9 (exp (ln 5.0)) 5.0
  -- ln(exp(x)) = x
  . testNear "ln-exp" 1e-9 (ln (exp 3.0)) 3.0
  )

-------------------------------------------------------------------------------
-- Roots

testRoots :: Test
testRoots =
  ( testNear "sqrt 0" 1e-9 (sqrt 0.0) 0.0
  . testNear "sqrt 1" 1e-9 (sqrt 1.0) 1.0
  . testNear "sqrt 4" 1e-9 (sqrt 4.0) 2.0
  . testNear "sqrt 9" 1e-9 (sqrt 9.0) 3.0
  . testNear "sqrt 2" 1e-9 (sqrt 2.0) 1.4142135623730951
  -- sqrt(x)^2 = x
  . testNear "sqrt-sq" 1e-9 (sqrt 7.0 ** 2.0) 7.0
  )

-------------------------------------------------------------------------------
-- Rounding

testRounding :: Test
testRounding =
  ( testNear "round 2.3" 1e-9 (round 2.3) 2.0
  . testNear "round 2.7" 1e-9 (round 2.7) 3.0
  . testNear "round -2.3" 1e-9 (round (0.0 - 2.3)) (0.0 - 2.0)
  . testNear "round -2.7" 1e-9 (round (0.0 - 2.7)) (0.0 - 3.0)
  . testNear "ceil 2.1" 1e-9 (ceil 2.1) 3.0
  . testNear "ceil 2.0" 1e-9 (ceil 2.0) 2.0
  . testNear "ceil -2.1" 1e-9 (ceil (0.0 - 2.1)) (0.0 - 2.0)
  . testNear "floor 2.9" 1e-9 (floor 2.9) 2.0
  . testNear "floor 2.0" 1e-9 (floor 2.0) 2.0
  . testNear "floor -2.1" 1e-9 (floor (0.0 - 2.1)) (0.0 - 3.0)
  )

-------------------------------------------------------------------------------
-- Sign

testSign :: Test
testSign =
  ( testNear "sign 5" 1e-9 (sign 5.0) 1.0
  . testNear "sign -5" 1e-9 (sign (0.0 - 5.0)) (0.0 - 1.0)
  . testNear "sign 0" 1e-9 (sign 0.0) 0.0
  )
