module math (*)

import root

-- Constants

pi :: Numeric a => a
e :: Numeric a => a

-- Trigonometric

sin :: Numeric a => a -> a
cos :: Numeric a => a -> a
tan :: Numeric a => a -> a
asin :: Numeric a => a -> a
acos :: Numeric a => a -> a
atan :: Numeric a => a -> a
atan2 :: Numeric a => a -> a -> a

-- Hyperbolic

sinh :: Numeric a => a -> a
cosh :: Numeric a => a -> a
tanh :: Numeric a => a -> a
asinh :: Numeric a => a -> a
acosh :: Numeric a => a -> a
atanh :: Numeric a => a -> a

-- Exponential and logarithmic

exp :: Numeric a => a -> a
log2 :: Numeric a => a -> a
log10 :: Numeric a => a -> a

-- Roots

sqrt :: Numeric a => a -> a

-- Rounding

round :: Numeric a => a -> a
ceil :: Numeric a => a -> a
floor :: Numeric a => a -> a

-- Sign

sign :: Numeric a => a -> a
