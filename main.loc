module math (*)

import root

-- Constants

pi a :: Numeric a => a
e a :: Numeric a => a

-- Trigonometric

sin a :: Numeric a => a -> a
cos a :: Numeric a => a -> a
tan a :: Numeric a => a -> a
asin a :: Numeric a => a -> a
acos a :: Numeric a => a -> a
atan a :: Numeric a => a -> a
atan2 a :: Numeric a => a -> a -> a

-- Hyperbolic

sinh a :: Numeric a => a -> a
cosh a :: Numeric a => a -> a
tanh a :: Numeric a => a -> a
asinh a :: Numeric a => a -> a
acosh a :: Numeric a => a -> a
atanh a :: Numeric a => a -> a

-- Exponential and logarithmic

exp a :: Numeric a => a -> a
log2 a :: Numeric a => a -> a
log10 a :: Numeric a => a -> a

-- Roots

sqrt a :: Numeric a => a -> a

-- Rounding

round a :: Numeric a => a -> a
ceil a :: Numeric a => a -> a
floor a :: Numeric a => a -> a

-- Sign

sign a :: Numeric a => a -> a
